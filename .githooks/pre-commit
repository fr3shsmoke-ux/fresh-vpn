#!/bin/sh
# Сеть на секреты при фиксации. Ставится через core.hooksPath=.githooks
#
# 🔴 ИМЕНА ПЕРЕМЕННЫХ ЗДЕСЬ ТОЛЬКО ЛАТИНИЦЕЙ. Первая редакция этого файла была
# написана с кириллическими именами: `sh` таким именем присваивание не
# признаёт и читает строку как команду — «КОРЕНЬ=D:/...: No such file or
# directory». Ошибка исполнения, невидимая при чтении (М-43). Хук при этом
# отбил фиксацию — но по причине «я сломан», а не «нашёл секрет», и эти два
# исхода обязаны выглядеть по-разному.
#
# 🔴 ПОЧЕМУ ОТКАЗ, А НЕ ПРЕДУПРЕЖДЕНИЕ. Упавшая проверка есть отсутствие
# проверки, а отсутствие проверки не может значить «разрешено» (М-14).
# Четыре исхода, и фиксация идёт ровно в одном:
#   · сеть нашла значение        → отказ;
#   · сети нет на месте          → отказ, а не «пропустим, раз нет инструмента»;
#   · сеть не прошла калибровку  → отказ;
#   · сеть отработала и молчит   → фиксация идёт.
#
# Обойти осознанно: git commit --no-verify. Это видно человеку и остаётся его
# решением; молчаливого обхода здесь нет.

set -u

root=$(git rev-parse --show-toplevel) || exit 1
py="$root/.venv/Scripts/python.exe"
net="$root/tools/сеть_на_секреты.py"

if [ ! -x "$py" ]; then
    py=$(command -v python3 || command -v python || true)
fi

if [ -z "${py:-}" ] || [ ! -f "$net" ]; then
    echo "ОТКАЗ: сеть на секреты недостижима." >&2
    echo "  интерпретатор: ${py:-не найден}" >&2
    echo "  сеть: $net" >&2
    echo "  Фиксация запрещена: отсутствие проверки не значит «разрешено»." >&2
    exit 1
fi

# Калибровка ПЕРЕД показаниями: инструмент, не прошедший эталонной пробы,
# показаний не даёт (Ф-12). Стоит копейки — шесть образцов в памяти.
if ! "$py" "$net" --проба >/dev/null 2>&1; then
    echo "ОТКАЗ: сеть на секреты не прошла калибровку образцами." >&2
    echo "  Запустите: python tools/сеть_на_секреты.py --проба" >&2
    exit 1
fi

exec "$py" "$net" --фиксация
