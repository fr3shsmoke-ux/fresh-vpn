{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Edit|Write|NotebookEdit|MultiEdit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Users/AIMar/scoop/shims/python.exe D:/fresh-fork/amnezia-client/.claude/hooks/guard_secrets.py",
                                                           "timeout":  15
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Edit|Write|MultiEdit|NotebookEdit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Users/AIMar/scoop/shims/python.exe D:/fresh-fork/amnezia-client/.claude/hooks/guard_paths.py"
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Bash|PowerShell",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Users/AIMar/scoop/shims/python.exe D:/fresh-fork/amnezia-client/.claude/hooks/guard_bash.py"
                                                       }
                                                   ]
                                     }
                                 ]
              },
    "permissions":  {
                        "allow":  [
                                      "Bash(python:*)",
                                      "Bash(git status:*)",
                                      "Bash(git diff:*)",
                                      "Bash(git add:*)",
                                      "Bash(git commit:*)",
                                      "Bash(git config:*)",
                                      "Bash(git hash-object:*)",
                                      "Bash(gitleaks:*)",
                                      "Bash(schtasks /Query:*)"
                                  ],
                        "deny":  [
                                     "Write(.claude/**)",
                                     "Edit(.claude/**)",
                                     "MultiEdit(.claude/**)",
                                     "Read(.env)",
                                     "Read(**/.env)",
                                     "Read(**/.env.local)",
                                     "Read(**/.env.prod)",
                                     "Read(**/.env.production)",
                                     "Read(**/.env.development)",
                                     "Read(**/*.pem)",
                                     "Read(**/*.key)",
                                     "Read(secrets/**)",
                                     "Bash(ssh:*)",
                                     "Bash(scp:*)",
                                     "Bash(sftp:*)",
                                     "Bash(plink:*)",
                                     "Bash(pscp:*)"
                                 ]
                    }
}